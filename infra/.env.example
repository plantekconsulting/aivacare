# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
MODEL_MAIN=claude-opus-5-5
MODEL_FAST=claude-haiku-5-5
JWT_SECRET=change-me
# Required: pick your own database password (local and cloud)
POSTGRES_PASSWORD=
# Public URL of the API as seen by browsers/phones
PUBLIC_API_URL=http://localhost:8710
# Cloud only (Caddy): e.g. app.34-1-2-3.sslip.io / api.34-1-2-3.sslip.io
APP_HOST=localhost
API_HOST=api.localhost
CORS_ORIGINS=*
